{
  "expo": {
    "name": "AquaSense",
    "slug": "AquaSense",
    "scheme": "aquasense",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/aquasense.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/aquasense.png",
      "resizeMode": "contain",
      "backgroundColor": "#1B365D"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/aquasense.png",
        "backgroundColor": "#1B365D"
      }
    },
    "web": {
      "favicon": "./assets/aquasense.png"
    },
    "plugins": [
      "expo-web-browser"
    ]
  }
}