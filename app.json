{
  "expo": {
    "name": "AquaSense",
    "slug": "AquaSense",
    "scheme": "aquasense",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/aquasense.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/aquasense.png",
      "resizeMode": "contain",
      "backgroundColor": "#1B365D"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/aquasense.png",
        "backgroundColor": "#1B365D"
      },
      "package": "com.gabhtml.AquaSense"
    },
    "web": {
      "favicon": "./assets/aquasense.png"
    },
    "plugins": [
      "expo-web-browser"
    ],
    "extra": {
      "eas": {
        "projectId": "f340dd92-b07e-4ff0-bb9b-3d17b56d4d7a"
      }
    }
  }
}
